# --- Django ---
DJANGO_SECRET_KEY=genere-una-clave-aleatoria-de-50-caracteres
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=dominio.com,www.dominio.com
DJANGO_SETTINGS_MODULE=config.settings.production
CSRF_TRUSTED_ORIGINS=https://dominio.com,https://www.dominio.com
# Directorio del host que contiene fullchain.pem y privkey.pem para Nginx.
TLS_CERT_DIR=./deployment/tls

# --- MySQL ---
DB_NAME=puntoventa
DB_USER=puntoventa
DB_PASSWORD=cambieme
DB_ROOT_PASSWORD=cambie-tambien-la-clave-root
DB_HOST=db
DB_PORT=3306

# --- Redis / Celery ---
REDIS_URL=redis://cache:6379/0
CELERY_BROKER_URL=redis://cache:6379/1

# --- Localizacion ---
TIME_ZONE=America/Lima
DEFAULT_CURRENCY=PEN

# --- Alertas de inventario ---
STOCK_ALERTA_DESTINATARIOS=compras@puntoventa.local

# --- Pedidos: correo real (produccion) ---
# Configurar con el servidor y remitente autorizados del negocio.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=pedidos@puntoventa.local

